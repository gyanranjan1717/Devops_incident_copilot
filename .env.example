# =================================================================
# DevOps Incident Copilot - Environment Configuration Template
# =================================================================

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development

# Model Provider Selection ("gemini" or "ollama")
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_EMBEDDING_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL_NAME=gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Local Model (Ollama) Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=devops_knowledge_base

# Diagnostics & MCP Telemetry Sources
# 1. Neon PostgreSQL Database (Connection URL with pooling or direct)
POSTGRES_DIAGNOSTIC_DB_URL=postgresql://user:password@ep-xyz-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_PROJECT_ID=falling-dew-28348006

# 2. Render Backend Logs & Service
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxx
RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx
RENDER_SERVICE_URL=https://your-service.onrender.com

# 3. Vercel Frontend Logs & Project
VERCEL_API_TOKEN=vcp_xxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx
